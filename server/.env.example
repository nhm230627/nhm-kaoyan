# BFF 环境变量模板
# 用法：复制本文件为 .env（或直接在系统环境变量里配），真值绝不要提交进仓库。
# 注意：本服务不读 .env 文件，只读系统环境变量和同目录的 .key 文件。
#       想用文件方式，就把 Key 单独写进 .key（已被 .gitignore 排除）。

# 上游模型密钥（必填）。留空则 /health 显示 keyConfigured:false，所有 AI 接口返回 503
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名，可换 deepseek-chat / deepseek-reasoner
MODEL=deepseek-chat

# 监听端口
PORT=4318

# 每台设备每日调用上限（防刷）
DAILY_LIMIT=60

# 单次上游超时（毫秒）
TIMEOUT_MS=60000

# 客户端令牌：App 请求时必须带 X-Service-Token 且与此一致
# 这只是防顺手脚本的最基本门槛，不是强鉴权；正式版要换成按用户签发的短令牌
SERVICE_TOKEN=dev-token-change-me
